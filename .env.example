# Copy to .env at the repo root (or apps/api/.env). Never commit real values.
# The API reads the repo-root .env and apps/api/.env. Process environment wins.

# --- API ---
PORT=8787
# Public URL of this API, used for Stripe return pages.
PUBLIC_BASE_URL=http://localhost:8787
# Where the SQLite file and generated order emails are written.
DATA_DIR=data

# Staff screen. Required for /api/admin. Use a long random value in production.
ADMIN_TOKEN=change-me

# --- Assistant ---
# mock | openai | anthropic
# If unset, the API uses openai or anthropic when a key is present, otherwise mock.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Stripe (test mode only; sk_live_ keys are refused) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Drop-ship email ---
# email | api-edi   (api-edi is a stub for a future supplier API)
SUPPLIER_ADAPTER=email
SUPPLIER_NAME=DHS (Direct Heating Spares)
# Placeholder until the real DHS trade-orders inbox is confirmed.
# The knowledge base lists DHS phone 0330 123 3707, not an orders email.
SUPPLIER_ORDER_EMAIL=orders@dhsspares.example
WICKFORD_ORDERS_EMAIL=orders@wickfordplumbing.example
ORDER_FROM_EMAIL=orders@wickfordplumbing.example
ORDER_FROM_NAME=Wickford Plumbing Supplies

# Optional. If SMTP_HOST is empty, the order email is still generated and saved
# to data/outbox and on the order record.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --- Mobile (also copy the EXPO_PUBLIC_ line into apps/mobile/.env) ---
# Phone on the same Wi-Fi: use the computer's LAN address, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:8787
